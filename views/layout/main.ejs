<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Absensi ART</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <% if (currentUser) { %>
  <header class="topbar">
    <div class="topbar-title">Absensi ART</div>
    <nav class="topbar-nav">
      <% if (currentUser.role === 'art') { %>
        <a href="/absen">Absen</a>
      <% } else { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/laporan/mingguan">Laporan Mingguan</a>
        <a href="/lokasi">Titik Lokasi</a>
        <a href="/pengaturan/jam-kerja">Pengaturan</a>
      <% } %>
    </nav>
    <form action="/logout" method="POST" class="logout-form">
      <span class="topbar-user"><%= currentUser.fullName %></span>
      <button type="submit">Keluar</button>
    </form>
  </header>
  <% } %>
  <main class="container">
    <%- body %>
  </main>
</body>
</html>
