<div class="pengaturan-page">
  <h1>Pengaturan Jam Kerja</h1>

  <% if (saved) { %>
    <p class="success-text">Pengaturan berhasil disimpan.</p>
  <% } %>

  <form class="settings-form" method="POST" action="/pengaturan/jam-kerja">
    <label>
      Jam pulang normal
      <input type="time" name="normalCheckoutTime" value="<%= settings.normal_checkout_time.slice(0,5) %>" required />
    </label>
    <button type="submit">Simpan</button>
  </form>
  <p class="hint-text">Jika ART checkout setelah jam ini, selisihnya akan dihitung sebagai jam lembur.</p>
</div>
